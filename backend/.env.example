# SLC University Clinic System - environment template.
# Copy this file to `.env` and edit the values for your machine:
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# `.env` is gitignored - never commit real credentials.
# Do not use the MySQL root account. Create a separate MySQL user for this app.

# ---- MySQL connection ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=clinic_app
DB_PASSWORD=change-this-password
DB_NAME=clinic

# ---- HTTP server ----
HOST=127.0.0.1
PORT=3000

# Set to `production` on a real server. It turns on request logging and refuses unsafe settings
# (empty DB password, DB_USER=root).
# NODE_ENV=production

# Set to `true` when serving over HTTPS (always, in production). Also enables HSTS.
COOKIE_SECURE=false

# Number of reverse proxies in front of the app (1 for one nginx/Caddy), or a list of proxy IPs.
# Needed so the login rate limit and logs see the real visitor address. Leave unset with no proxy.
# TRUST_PROXY=1

# Log one line per request (method, path, status, time; never the query string).
# Defaults to true in production, false otherwise.
# LOG_REQUESTS=true

# Only for `npm run seed-users` in production: password for the seeded nurse1/doctor1 accounts.
# SEED_PASSWORD=

# Optional: lock the API to a specific origin (e.g. https://clinic.example.edu).
# CLINIC_ORIGIN=

# ---- Certificate letterhead ----
UNIVERSITY_NAME=University of La Salette, Inc.
CLINIC_NAME=Health Services Department
CLINIC_ADDRESS=Castroverde St., Dubinan West, Santiago City, Isabela 3311
CLINIC_CONTACT=