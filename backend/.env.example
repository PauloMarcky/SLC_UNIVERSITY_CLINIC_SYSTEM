# SLC University Clinic System — environment template.
# Copy this file to `.env` and edit the values for your machine:
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# `.env` is gitignored — never commit real credentials.

# ---- MySQL connection ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinic

# ---- HTTP server ----
HOST=127.0.0.1
PORT=3000

# Set to `true` only when serving over HTTPS in production.
COOKIE_SECURE=false

# Optional: lock the API to a specific origin (e.g. https://clinic.example.edu).
# CLINIC_ORIGIN=

# ---- Certificate letterhead ----
UNIVERSITY_NAME=Saint Louis College
CLINIC_NAME=University Clinic
CLINIC_ADDRESS=
CLINIC_CONTACT=