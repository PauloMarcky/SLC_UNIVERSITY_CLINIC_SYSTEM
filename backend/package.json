{
  "name": "slc-university-clinic-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env start.js",
    "dev": "node --watch --env-file-if-exists=.env start.js",
    "create-user": "node --env-file-if-exists=.env create-user.js",
    "seed-users": "node --env-file-if-exists=.env scripts/seed-users.js",
    "migrate": "node --env-file-if-exists=.env database/migrate.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mysql2": "^3.24.5"
  }
}