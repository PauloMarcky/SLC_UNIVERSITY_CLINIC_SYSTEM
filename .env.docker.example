# Used by docker-compose.yml. Copy to ".env" next to docker-compose.yml and set real values.
# Generate passwords with:  openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
DB_USER=clinic_app
DB_NAME=clinic

# Public address staff use, exactly as typed in the browser (no trailing slash).
CLINIC_ORIGIN=https://clinic.example.edu
# true when served over HTTPS (recommended). Set false only for a plain-HTTP LAN trial.
COOKIE_SECURE=true
# Number of reverse proxies in front of the app (1 for a single Caddy/nginx).
TRUST_PROXY=1

UNIVERSITY_NAME=University of La Salette, Inc.
CLINIC_NAME=Health Services Department
CLINIC_ADDRESS=Castroverde St., Dubinan West, Santiago City, Isabela 3311
CLINIC_CONTACT=
